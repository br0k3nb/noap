# Google OAuth (required)
VITE_VERCEL_GOOGLE_CLIENT_ID=149159576823-8k9vuolgao75f068vnsj66ufqp1k6f6e.apps.googleusercontent.com

# API URL — easy switch for local testing
# Rust backend binds to 0.0.0.0:3002, but browsers use localhost/127.0.0.1:
VITE_API_URL=http://localhost:3002
# VITE_API_URL=http://127.0.0.1:3002
# VITE_API_URL=http://0.0.0.0:3002  # also works, but Chrome may block 0.0.0.0 via PNA
# Production (default if omitted):
# VITE_API_URL=https://noap-backend.vercel.app

# Legacy alias (still supported, VITE_API_URL takes precedence):
# VITE_BACKEND_URL=http://localhost:3002
